<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenGL ES 3.0: 32 bit indeksler ile büyük modeller -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Yalnızca reklamlar için; CAD dosyaları hiçbir yere gönderilmez -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepViewer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Birlikte aç": CAD ve mesh MIME türleriyle gelen dosyalar -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="model/step" />
                <data android:mimeType="model/stp" />
                <data android:mimeType="model/x-step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/stp" />
                <data android:mimeType="application/x-step" />
                <data android:mimeType="application/x-stp" />
                <data android:mimeType="application/p21" />
                <data android:mimeType="model/iges" />
                <data android:mimeType="application/iges" />
                <data android:mimeType="application/x-iges" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/vnd.collada+xml" />
                <data android:mimeType="application/x-3ds" />
                <data android:mimeType="image/x-3ds" />
                <data android:mimeType="application/x-fbx" />
                <data android:mimeType="model/x-fbx" />
                <data android:mimeType="application/x-ply" />
            </intent-filter>

            <!-- Çoğu dosya yöneticisi .step dosyalarını genel tür olarak bildirir -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Uzantıya göre eşleştirme (dosya yolu görünen kaynaklar için) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.STEP" />
                <data android:pathPattern=".*\\.stp" />
                <data android:pathPattern=".*\\.STP" />
                <data android:pathPattern=".*\\..*\\.step" />
                <data android:pathPattern=".*\\..*\\.stp" />
                <data android:pathPattern=".*\\.igs" />
                <data android:pathPattern=".*\\.IGS" />
                <data android:pathPattern=".*\\.iges" />
                <data android:pathPattern=".*\\.IGES" />
                <data android:pathPattern=".*\\.brep" />
                <data android:pathPattern=".*\\.BREP" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.OBJ" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.STL" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\.GLTF" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\.GLB" />
                <data android:pathPattern=".*\\.dae" />
                <data android:pathPattern=".*\\.DAE" />
                <data android:pathPattern=".*\\.3ds" />
                <data android:pathPattern=".*\\.3DS" />
                <data android:pathPattern=".*\\.fbx" />
                <data android:pathPattern=".*\\.FBX" />
                <data android:pathPattern=".*\\.ply" />
                <data android:pathPattern=".*\\.PLY" />
            </intent-filter>
        </activity>

        <!-- AdMob uygulama kimliği (build.gradle.kts içinden) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Ekran görüntüsü paylaşımı için -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
