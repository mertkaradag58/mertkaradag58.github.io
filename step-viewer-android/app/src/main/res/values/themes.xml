<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StepViewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF002544</item>
        <item name="colorPrimaryContainer">@color/accent_dark</item>
        <item name="colorOnPrimaryContainer">#FFD3E4FF</item>
        <item name="colorSecondary">@color/measure</item>
        <item name="colorSurface">#FF1C2027</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceContainer">#FF1F232B</item>
        <item name="colorSurfaceContainerHigh">#FF262B34</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Alt araç çubuğu düğmesi (simge + yazı) -->
    <style name="ToolButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/tool_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="tint">@color/text</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="ToolLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Sağdaki yuvarlak küçük düğmeler -->
    <style name="SideButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="iconSize">22dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="iconTint">@color/text</item>
    </style>
</resources>
