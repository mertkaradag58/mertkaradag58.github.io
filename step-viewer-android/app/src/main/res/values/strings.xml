    <string name="tour_open_title">Open your files</string>
    <string name="tour_open_body">Open STEP, IGES and 3D files from your phone, e-mail or WhatsApp, even inside ZIP files. Add a folder once and all CAD files in it are listed.</string>
    <string name="tour_gestures_title">Move the model</string>
    <string name="tour_gestures_body">One finger rotates, two fingers zoom and pan. Double tap a point to rotate around it. The cube button on the right holds standard and saved views.</string>
    <string name="tour_measure_title">Measure precisely</string>
    <string name="tour_measure_body">Smart: edges, faces and corners. Point: snaps to corners, midpoints and centers and shows X Y Z. Total: adds up lengths and areas. Long press shows a magnifier above your finger.</string>
