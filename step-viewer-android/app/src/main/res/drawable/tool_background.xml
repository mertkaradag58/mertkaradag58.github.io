<?xml version="1.0" encoding="utf-8"?>
<!-- Alt araç çubuğundaki düğmelerin seçili / basılı durumları (yumuşak geçişli) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33E8650E">
    <item>
        <selector android:enterFadeDuration="220" android:exitFadeDuration="180">
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tool_active" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
