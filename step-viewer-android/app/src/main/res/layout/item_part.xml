<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="4dp">

    <Space
        android:id="@+id/part_indent"
        android:layout_width="16dp"
        android:layout_height="1dp" />

    <ImageView
        android:id="@+id/part_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_part"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/part_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/part_isolate"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/part_isolate"
        app:icon="@drawable/ic_isolate"
        app:iconTint="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/part_visibility"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/part_toggle"
        app:icon="@drawable/ic_visibility"
        app:iconTint="@color/text" />
</LinearLayout>
